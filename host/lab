#!/usr/bin/env bash
# Mac-side control for the lab container. The app will later call the same operations.
#
#   lab build                  build the image (and recreate the container if it exists)
#   lab up [filter]            connect with the .ovpn in workspace/vpn/ matching filter
#   lab off                    disconnect (all egress stays blocked)
#   lab status                 print workspace/state/status.json
#   lab target <ip> [ip...]    allow lab traffic only to machines you spawned (lab target clear)
#   lab shell                  open the student terminal (commands are logged for the tutor)
#   lab history [n]            last n logged commands
#   lab logs                   supervisor events
#   lab capture live           stream lab traffic into Wireshark
#   lab capture save [secs]    save to workspace/captures/<time>.pcap (default 30 s)
#   lab capture summary <file> text summary of a capture (what the tutor reads)
#   lab burp                   launch Burp pre-configured to use the lab proxy
#   lab doctor [tool...]       read-only health report (Docker, lab, tools); safe for the tutor
#
# Environment: LAB_WORKSPACE (default <repo>/workspace), LAB_IMAGE (default kali-lab:dev)
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
WORKSPACE=${LAB_WORKSPACE:-$ROOT/workspace}
IMAGE=${LAB_IMAGE:-kali-lab:dev}
CONTAINER=kali-lab
STATE=$WORKSPACE/state
mkdir -p "$WORKSPACE/vpn" "$STATE" "$WORKSPACE/captures" "$WORKSPACE/logs"

# Control state is written from INSIDE the container (atomic temp + rename). Docker Desktop's
# file sharing can serve a stale copy of a Mac-side change for 30 s+, so the shared folder is
# only used for data, never for commands. Falls back to a local write if the container is down.
write_state() {
  if docker exec kali-lab true 2>/dev/null; then
    printf '%s\n' "$2" | docker exec -i kali-lab sh -c \
      "cat > /lab/state/.$1.tmp && mv /lab/state/.$1.tmp /lab/state/$1"
  else
    printf '%s\n' "$2" > "$STATE/.$1.tmp" && mv "$STATE/.$1.tmp" "$STATE/$1"
  fi
}

field() {
  python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' \
    "$STATE/status.json" "$1" 2>/dev/null
}

ensure_container() {
  if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    docker run -d --name "$CONTAINER" --init --restart unless-stopped \
      --cap-add=NET_ADMIN --device /dev/net/tun \
      -p 127.0.0.1:1080:1080 -v "$WORKSPACE":/lab "$IMAGE" >/dev/null
  fi
  docker start "$CONTAINER" >/dev/null
}

cmd_build() {
  docker build -q -t "$IMAGE" "$ROOT/container" >/dev/null
  echo "built $IMAGE ($(docker image ls "$IMAGE" --format '{{.Size}}'))"
  if docker inspect "$CONTAINER" >/dev/null 2>&1; then
    docker rm -f "$CONTAINER" >/dev/null
    ensure_container
    echo "container recreated"
  fi
}

cmd_up() {
  local filter=${1:-} matches="" count=0 sel t0 st=starting f name
  for f in "$WORKSPACE"/vpn/*.ovpn; do
    [ -e "$f" ] || continue
    name=$(basename "$f")
    case "$(tr '[:upper:]' '[:lower:]' <<< "$name")" in
      *"$(tr '[:upper:]' '[:lower:]' <<< "$filter")"*) matches=$f; count=$((count + 1)) ;;
    esac
  done
  if [ "$count" -ne 1 ]; then
    echo "'${filter:-*}' matches $count .ovpn files in $WORKSPACE/vpn:"
    for f in "$WORKSPACE"/vpn/*.ovpn; do
      [ -e "$f" ] && echo "  $(basename "$f")  ->  $(grep -m1 '^remote ' "$f" | cut -d' ' -f2)"
    done
    echo "Pass a word from one file name, e.g. lab up starting"
    exit 1
  fi
  sel=$(basename "$matches")
  t0=$(date +%s)
  ensure_container
  write_state selected-vpn "$sel"
  echo "using $sel"
  for _ in $(seq 1 30); do
    if [ "$(field vpn_file)" = "$sel" ] && [ "$(field updated)" -gt "$t0" ]; then
      st=$(field state)
      case "$st" in connected|error) break ;; esac
    fi
    sleep 2
  done
  python3 -m json.tool "$STATE/status.json"
  [ "$st" = connected ]
}

# Set targets and return only once the supervisor has applied them, so the student's next
# command is never blocked by a scope that is still being installed.
cmd_target() {
  local want="" t0
  if [ "${1:-}" != clear ] && [ $# -gt 0 ]; then want="$*"; fi
  write_state scope "$(printf '%s\n' "$@" | grep -vx clear)"
  t0=$(date +%s)
  while [ $(( $(date +%s) - t0 )) -lt 15 ]; do
    # Done when every requested address shows up as either accepted or refused.
    if python3 - "$STATE/status.json" "$want" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
seen = set((d.get("targets", "") + " " + d.get("blocked_targets", "")).split())
sys.exit(0 if seen == set(sys.argv[2].split()) else 1)
PY
    then
      echo "targets: $(field targets)"
      [ -z "$(field blocked_targets)" ] || echo "blocked: $(field blocked_targets) - $(field message)"
      return 0
    fi
    sleep 0.5
  done
  echo "the lab did not confirm the new targets (is it connected?)"; return 1
}

cmd_capture() {
  local wireshark=/Applications/Wireshark.app/Contents/MacOS/Wireshark out secs f
  case "${1:-live}" in
    live)
      [ -x "$wireshark" ] || { echo "Wireshark is not installed in /Applications."; exit 1; }
      # -U flushes each packet so Wireshark updates live; exec -i (no -t) keeps the pipe binary-clean.
      docker exec -i "$CONTAINER" tcpdump -U -n -i tun0 -w - 2>/dev/null | "$wireshark" -k -i - ;;
    save)
      secs=${2:-30}
      out="captures/$(date +%Y%m%d-%H%M%S).pcap"
      echo "capturing tun0 for ${secs}s -> workspace/$out"
      docker exec "$CONTAINER" timeout "$secs" tcpdump -U -n -i tun0 -w "/lab/$out" 2>&1 | tail -2 || true
      echo "$out" ;;
    summary)
      f=${2:?usage: lab capture summary captures/<file>.pcap}
      docker exec "$CONTAINER" sh -c "
        echo '== protocols'; tshark -r '/lab/$f' -q -z io,phs 2>/dev/null | sed -n '/Protocol Hierarchy/,/====/p' | head -30
        echo '== conversations'; tshark -r '/lab/$f' -q -z conv,tcp 2>/dev/null | head -20
        echo '== first packets'; tshark -r '/lab/$f' -c 15 2>/dev/null" ;;
    *) echo "usage: lab capture live | save [secs] | summary <file>"; exit 1 ;;
  esac
}

cmd_burp() {
  open -a "/Applications/Burp Suite.app" --args \
    --user-config-file="$ROOT/host/burp/user-options.json" \
    --config-file="$ROOT/host/burp/project-options.json"
}

# Read-only health report of the student's own setup. The tutor may run this one command.
# It never sends anything to the lab: no network commands, no installs, no changes.
DOCTOR_TOOLS=(ssh nc telnet ftp smbclient redis-cli mysql curl nmap openvpn tcpdump tshark)
cmd_doctor() {
  local t tools
  # No tools named: check the standard set. (bash 3.2 on macOS treats an empty array as unbound.)
  if [ $# -eq 0 ]; then tools=("${DOCTOR_TOOLS[@]}"); else tools=("$@"); fi
  for t in "${tools[@]}"; do
    [[ "$t" =~ ^[A-Za-z0-9._+-]{1,40}$ ]] || { echo "doctor: '$t' isn't a tool name"; exit 1; }
  done

  echo "== Docker"
  if ! docker info >/dev/null 2>&1; then echo "not running: start Docker Desktop"; return 0; fi
  echo "running (engine $(docker version --format '{{.Server.Version}}'))"

  echo "== Lab container"
  if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then echo "missing: run 'make build'"; return 0; fi
  docker inspect "$CONTAINER" --format 'state={{.State.Status}} image={{.Config.Image}} since={{.State.StartedAt}}'
  if [ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}')" != true ]; then return 0; fi

  echo "== Lab status"
  docker exec "$CONTAINER" cat /lab/state/status.json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
for k in ("state", "message", "vpn_file", "lab_ip", "gateway_ms", "proxy", "kill_switch", "targets", "blocked_targets", "vpn_restarts"):
    print(k + ": " + str(d.get(k, str())))' || echo "no status yet"

  echo "== Recent lab events"
  docker exec "$CONTAINER" tail -n 8 /lab/state/events.log 2>/dev/null || echo "none"

  echo "== Tools in the lab"
  docker exec "$CONTAINER" sh -c 'for t in "$@"; do printf "%-12s %s\n" "$t" "$(command -v "$t" || echo MISSING)"; done' sh "${tools[@]}"

  echo "== Network interfaces (nothing is sent)"
  docker exec "$CONTAINER" ip -br addr | grep -E '^(lo|eth0|tun0)[@ ]' || true

  echo "== Image"
  docker image ls "$IMAGE" --format '{{.Repository}}:{{.Tag}} {{.Size}} built {{.CreatedSince}}'

  echo "== Mac apps"
  for t in "Burp Suite" "Burp Suite Community Edition" "Wireshark"; do
    [ -d "/Applications/$t.app" ] && echo "$t: installed"
  done
  return 0
}

case "${1:-status}" in
  build)   cmd_build ;;
  doctor)  shift; cmd_doctor "$@" ;;
  up)      shift; cmd_up "${1:-}" ;;
  off)     write_state selected-vpn ""; echo "disconnected" ;;
  status)  python3 -m json.tool "$STATE/status.json" ;;
  target)  shift; cmd_target "$@" ;;
  shell)   docker exec -it "$CONTAINER" lab-shell ;;
  history) tail -n "${2:-20}" "$WORKSPACE/logs/commands.jsonl" ;;
  logs)    tail -n "${2:-30}" "$STATE/events.log" ;;
  capture) shift; cmd_capture "$@" ;;
  burp)    cmd_burp ;;
  *)       sed -n '2,18p' "$0"; exit 1 ;;
esac
