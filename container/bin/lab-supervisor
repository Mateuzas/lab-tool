#!/usr/bin/env bash
# Lab supervisor: the container's main process. Keeps the kill switch, the VPN and the proxy up,
# and writes /lab/state/status.json for the app (state + plain-language message).
#
# /lab is the mounted workspace (user data only; code lives in the image).
# Inputs (written by the Mac side):
#   /lab/vpn/*.ovpn           the student's VPN files
#   /lab/state/selected-vpn   basename of the .ovpn to use (empty/missing = stay disconnected)
#   /lab/state/hold           if present, do not restart the VPN (used by drop tests)
#   /lab/state/scope          target IPs the student spawned (one per line); VPN traffic is
#                             allowed only to these and the HTB gateway
set -u

STATE=/lab/state
VPN_DIR=/lab/vpn
STATUS=$STATE/status.json
EVENTS=$STATE/events.log
VPN_LOG=/tmp/ovpn.log
HOOKS='^(script-security|up|down|route-up|route-pre-down|ipchange|plugin|tls-verify|auth-user-pass-verify|client-connect|learn-address)'
mkdir -p "$STATE"

vpn_pid=""; current=""; vpn_started=0; restarts=0; gw_fails=0; ever_connected=""
scope_sig=""; scope_ok=""; scope_bad=""; scope_applied=""   # scope_applied: targets the firewall allows now
declare -A tgt_seen tgt_fails   # per target: answered a ping at least once / consecutive misses
target_live=""                  # targets answering right now
target_lost=""                  # targets that answered before and have stopped (machine off or tunnel cut)
state=starting; message="Starting the lab"; state_since=$(date +%s); gateway_ms=""; refused=""

log() { echo "$(date -u +%FT%TZ) $*" >> "$EVENTS"; }

set_state() {
  if [ "$1" != "$state" ]; then
    log "state $state -> $1: $2"
    state_since=$(date +%s)
  fi
  state=$1; message=$2
}

write_status() {
  local lab_ip proxy ks server=""
  lab_ip=$(ip -4 -o addr show tun0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
  ss -ltn 2>/dev/null | grep -q ':1080 ' && proxy=up || proxy=down
  if iptables -S OUTPUT 2>/dev/null | grep -q -- '-o tun0'; then ks=on
  elif iptables -S OUTPUT 2>/dev/null | grep -q REJECT; then ks=block
  else ks=off; fi
  [ -n "$current" ] && server=$(awk '/^remote /{print $2; exit}' "$VPN_DIR/$current" 2>/dev/null)
  printf '{"state":"%s","message":"%s","vpn_file":"%s","server":"%s","lab_ip":"%s","gateway_ms":"%s","proxy":"%s","kill_switch":"%s","targets":"%s","blocked_targets":"%s","live_targets":"%s","lost_targets":"%s","vpn_restarts":%d,"state_since":%d,"updated":%d}\n' \
    "$state" "$message" "$current" "$server" "$lab_ip" "$gateway_ms" "$proxy" "$ks" \
    "$scope_ok" "$scope_bad" "$target_live" "$target_lost" "$restarts" "$state_since" "$(date +%s)" > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

stop_vpn() {
  pkill -x openvpn 2>/dev/null
  vpn_pid=""
}

vpn_alive() { [ -n "$vpn_pid" ] && kill -0 "$vpn_pid" 2>/dev/null; }

start_vpn() {
  # HTB pushes ping-restart 120; override so a dead tunnel is noticed in ~20 s.
  openvpn --config "$VPN_DIR/$current" --log "$VPN_LOG" \
    --pull-filter ignore ping --ping 5 --ping-restart 20 >/dev/null 2>&1 &
  vpn_pid=$!
  vpn_started=$(date +%s)
  log "openvpn started (pid $vpn_pid, $current)"
}

ensure_kill_switch() {
  if ! iptables -S OUTPUT 2>/dev/null | grep -q -- '-o tun0'; then
    if ! lab-kill-switch on "$VPN_DIR/$current" >/dev/null 2>&1; then
      lab-kill-switch block >/dev/null 2>&1
      return 1
    fi
    log "kill switch on"
    scope_sig=""   # fresh chain: scope must be re-applied
  fi
}

# A target that leaves the scope (new machine, network change, cleared) must also lose its open
# connections: the firewall keeps passing established traffic, and a session to a machine that is
# gone just freezes. Tell the student in their terminal, then end the program (ssh, ftp, nc...).
# The VPN and the proxy are never touched.
drop_sessions() {
  local ip=$1 line name pid tty pids=() names=()
  while read -r line; do
    name=$(sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\).*/\1/p' <<< "$line")
    pid=$(sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\).*/\2/p' <<< "$line")
    [ -n "$pid" ] || continue
    case "$name" in openvpn|microsocks|lab-supervisor) continue ;; esac
    pids+=("$pid"); names+=("$name")
  done < <(ss -tnpaH dst "$ip" 2>/dev/null)
  # Tell every terminal first, then end the programs (ending one can end another).
  for i in "${!pids[@]}"; do
    tty=$(readlink "/proc/${pids[$i]}/fd/2" 2>/dev/null)
    case "$tty" in /dev/pts/*) printf '\r\n[lab] %s ended: %s is no longer your target.\r\n' "${names[$i]}" "$ip" > "$tty" 2>/dev/null || true ;; esac
  done
  for i in "${!pids[@]}"; do
    kill -TERM "${pids[$i]}" 2>/dev/null && log "ended ${names[$i]} (pid ${pids[$i]}): $ip left the scope"
  done
}

# Allow VPN traffic only to the gateway and the student's own targets. A target counts only if
# the kernel would route it through the VPN, so typos and internet addresses are refused.
ensure_scope() {
  local gw=$1 ip ok="" bad="" sig
  while read -r ip || [ -n "$ip" ]; do   # also read a last line without a newline
    [ -n "$ip" ] || continue
    if grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' <<< "$ip" \
       && ip route get "$ip" 2>/dev/null | grep -q 'dev tun0'; then
      ok="$ok $ip"
    else
      bad="$bad $ip"
    fi
  done < <(tr -s ' ,\t' '\n' < "$STATE/scope" 2>/dev/null)
  scope_ok=${ok# }; scope_bad=${bad# }
  sig="$gw|$scope_ok"
  if [ "$sig" != "$scope_sig" ]; then
    # shellcheck disable=SC2086  # one argument per target is intended
    if lab-kill-switch scope "$gw" $scope_ok >/dev/null; then
      scope_sig=$sig
      for ip in $scope_applied; do
        case " $scope_ok " in *" $ip "*) ;; *) drop_sessions "$ip" ;; esac
      done
      scope_applied=$scope_ok
      log "scope: gateway $gw, targets: ${scope_ok:-none}${scope_bad:+, refused: $scope_bad}"
    fi
  fi
}

# Is the machine alive? Ping first; many machines block ping, so also try common TCP ports. A
# connection that opens or is actively refused both prove a host answered; only silence doesn't.
host_alive() {
  local ip=$1 p t pids=()
  ping -c 1 -W 1 "$ip" >/dev/null 2>&1 && return 0
  for p in 22 80 443 445 21 3389 8080; do
    ( timeout 1 bash -c "exec 3<>/dev/tcp/$ip/$p" 2>/dev/null; [ $? -ne 124 ] ) &
    pids+=($!)
  done
  for t in "${pids[@]}"; do wait "$t" && return 0; done   # only our probes: never openvpn/microsocks
  return 1
}

# Is each target answering? A target that has answered is lost after 3 misses in a row (~10 s);
# one that never answered after 10 (~30 s: machine not started, expired or wrong IP). One answer
# clears it. Speaking in "answering", not "up": a hardened box can stay silent and look the same.
check_targets() {
  local ip lost="" live="" known=" $scope_ok " limit
  for ip in "${!tgt_seen[@]}" "${!tgt_fails[@]}"; do   # forget targets the student removed
    case "$known" in *" $ip "*) ;; *) unset "tgt_seen[$ip]" "tgt_fails[$ip]" ;; esac
  done
  for ip in $scope_ok; do
    if host_alive "$ip"; then
      if [ -z "${tgt_seen[$ip]:-}" ]; then log "target $ip is answering"
      elif [ "${tgt_fails[$ip]:-0}" -ge 3 ]; then log "target $ip is back"; fi
      tgt_seen[$ip]=1; tgt_fails[$ip]=0; live="$live $ip"
    else
      tgt_fails[$ip]=$(( ${tgt_fails[$ip]:-0} + 1 ))
      limit=10; [ -n "${tgt_seen[$ip]:-}" ] && limit=3
      if [ "${tgt_fails[$ip]}" -ge "$limit" ]; then
        [ "${tgt_fails[$ip]}" -eq "$limit" ] && log "target $ip is not answering"
        lost="$lost $ip"
      fi
    fi
  done
  target_lost=${lost# }; target_live=${live# }
}

ensure_proxy() {
  local eth0
  eth0=$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1)
  if ! ss -ltn | grep -q "$eth0:1080 "; then
    pkill -x microsocks 2>/dev/null
    setsid microsocks -i "$eth0" -p 1080 >/tmp/socks.log 2>&1 &
    log "proxy started on $eth0:1080"
  fi
}

# Map OpenVPN log lines to something a beginner can act on.
classify_error() {
  local tail
  tail=$(tail -n 40 "$VPN_LOG" 2>/dev/null)
  case "$tail" in
    *AUTH_FAILED*)               echo "HTB rejected this VPN file. Download a fresh one from HTB." ;;
    *"Options error"*)           echo "This VPN file is damaged. Download it again from HTB." ;;
    *"Cannot open TUN/TAP"*)     echo "The lab cannot create its VPN device. Restart Docker Desktop." ;;
    *"Cannot resolve host"*|*RESOLVE*) echo "Cannot find HTB's VPN server. Check your internet connection." ;;
    *"TLS key negotiation failed"*|*"TLS Error"*) echo "Cannot reach HTB's VPN server. Your network may block it; try HTB's TCP VPN file." ;;
    *) echo "" ;;
  esac
}

trap 'stop_vpn; log "supervisor stopped"; exit 0' TERM INT
log "supervisor started"
lab-kill-switch block >/dev/null 2>&1   # closed until a VPN is chosen

while true; do
  selected=$(cat "$STATE/selected-vpn" 2>/dev/null | tr -d '[:space:]')

  if [ "$selected" != "$current" ]; then
    # A different lab network means different machines: the old target would be a stale address.
    [ -n "$current" ] && { : > "$STATE/scope"; scope_sig=""; scope_ok=""; scope_bad=""; log "target cleared: network changed"; }
    stop_vpn; current=$selected; refused=""; restarts=0; ever_connected=""
    tgt_seen=(); tgt_fails=(); target_lost=""; target_live=""
    lab-kill-switch block >/dev/null 2>&1
    if [ -n "$current" ] && [ -f "$VPN_DIR/$current" ] && grep -qE "$HOOKS" "$VPN_DIR/$current"; then
      refused=yes
      log "refused $current: contains script hooks"
    fi
  fi

  ensure_proxy

  if [ -z "$current" ]; then
    set_state disconnected "Choose a lab to connect to."
  elif [ ! -f "$VPN_DIR/$current" ]; then
    set_state error "The VPN file $current is missing. Download it from HTB."
  elif [ -n "$refused" ]; then
    set_state error "This VPN file contains commands that could run on your computer, so it was blocked. Download it again from HTB."
  elif ! ensure_kill_switch; then
    set_state offline "No internet connection. Waiting to reconnect."
  else
    if ! vpn_alive; then
      if [ -f "$STATE/hold" ]; then
        set_state offline "VPN paused."
      else
        [ "$vpn_started" -gt 0 ] && restarts=$((restarts + 1))
        start_vpn
      fi
    fi

    gw=$(ip route 2>/dev/null | awk '/ via .* dev tun0/{print $3; exit}')
    if [ -n "$gw" ]; then
      ensure_scope "$gw"
      gateway_ms=$(ping -c 1 -W 2 "$gw" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p')
      [ -n "$gateway_ms" ] && check_targets || { target_lost=""; target_live=""; }   # no tunnel, no verdict on the machine
    else
      gateway_ms=""; target_lost=""; target_live=""
    fi

    if [ -n "$gateway_ms" ]; then
      gw_fails=0; ever_connected=yes
      if [ -n "$scope_bad" ]; then
        set_state connected "Connected. $scope_bad is not a lab address, so it stays blocked."
      elif [ -z "$scope_ok" ]; then
        set_state connected "Connected. Pick the machine you spawned to start."
      elif [ -n "$target_lost" ]; then
        set_state connected "Connected, but $target_lost isn't answering. Is the machine running on HTB?"
      elif [ -n "$target_live" ]; then
        set_state connected "Connected. Target: $scope_ok"
      else
        set_state connected "Connected. Waiting for $scope_ok to answer..."
      fi
    elif vpn_alive; then
      err=$(classify_error)
      gw_fails=$((gw_fails + 1))
      age=$(( $(date +%s) - vpn_started ))
      network_err=""
      case "$err" in *"reach HTB"*|*"internet connection"*) network_err=yes ;; esac
      if [ -n "$err" ] && ! { [ -n "$ever_connected" ] && [ -n "$network_err" ]; }; then
        # Setup problems always show; network errors only before the file has ever worked.
        set_state error "$err"
      elif [ "$state" = connected ] && [ "$gw_fails" -lt 3 ]; then
        :   # one or two lost pings: not worth alarming anyone
      elif [ "$age" -gt 45 ]; then
        set_state reconnecting "Lost the connection to HTB. Reconnecting..."
      else
        set_state connecting "Connecting to the lab..."
      fi
    fi
  fi

  write_status
  sleep 3
done
