# User data: VPN files (credentials), status, captures. Never commit.
workspace/

# Secrets: only SOPS-encrypted files are allowed (docs/SECRETS.md, ADR 006).
# workspace/secrets/ is already covered by workspace/ above.
.env
.env.*
*.ovpn
*.agekey
*.key
keys.txt
*.dec.*
*.enc.*.tmp

# Python bytecode (host/bounty runs with -B, this is a backstop)
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store
